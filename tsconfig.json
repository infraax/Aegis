{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "classifier/**/*.ts",
    "router/**/*.ts",
    "tarpit/**/*.ts",
    "honeypot/**/*.ts",
    "attribution/**/*.ts",
    "supply-chain/**/*.ts",
    "intel-export/**/*.ts",
    "mcp/**/*.ts",
    "**/__tests__/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
