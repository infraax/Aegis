[Unit]
Description=Aegis Canary Token Callback Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aegis
Group=aegis
WorkingDirectory=/opt/aegis
EnvironmentFile=/opt/aegis/.env
ExecStart=/usr/bin/node /opt/aegis/dist/attribution/canary-tracker.js
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aegis-canary
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
