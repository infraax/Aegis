# ============================================================
# Aegis Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Network
DECEPTION_IP=<eth1-or-vlan-ip>        # IP of the deception-facing interface
MANAGEMENT_IP=<eth0-ip>               # IP of the WireGuard management interface
WIREGUARD_PEER_PI5=10.99.0.1          # Pi5 GUN relay address (mesh)

# GUN Relay (Pi5)
GUN_RELAY_URL=ws://10.99.0.1:8765/gun

# Classifier
CLASSIFIER_PORT=9000                  # Internal classifier listener port

# Tarpit
HTTP_TARPIT_PORT=8888                 # Internal HTTP tarpit (mapped to :80 via Docker)

# Canary server
CANARY_SERVER_PORT=4444               # Callback receiver for canary tokens
CANARY_BASE_DOMAIN=<your-canary-domain.com>

# Attribution / Threat Intel APIs (all free tier)
ABUSEIPDB_API_KEY=<key>
ALIENVAULT_OTX_KEY=<key>
SHODAN_API_KEY=<key>

# MaxMind GeoIP (free GeoLite2 — register at maxmind.com)
MAXMIND_LICENSE_KEY=<key>
MAXMIND_DB_PATH=/opt/aegis/geoip/GeoLite2-City.mmdb

# Supply Chain
SBOM_DB_PATH=/opt/aegis/data/sbom.sqlite
CVE_POLL_INTERVAL_MINUTES=60
GITHUB_TOKEN=<pat-for-advisory-api>   # Optional — increases rate limit

# PWA Push Notifications (if using web push)
VAPID_PUBLIC_KEY=<key>
VAPID_PRIVATE_KEY=<key>
VAPID_EMAIL=mailto:<you@example.com>

# Logging
LOG_LEVEL=info                        # debug | info | warn | error
LOG_DIR=/var/log/aegis
